page{background:#fff;color:#1a1d23}
.consult-page{padding:35rpx;min-height:100vh;box-sizing:border-box}
.consult-logo{font-size:24rpx;font-weight:900;letter-spacing:1rpx}
.consult-title{font-size:42rpx;font-weight:900;margin:32rpx 0 6rpx}
.consult-sub,.consult-info{font-size:23rpx;color:#79818b;line-height:1.65;margin:15rpx 0}
.consult-product{border:1rpx solid #e6e7eb;padding:21rpx;border-radius:15rpx;margin:28rpx 0}
.consult-image{width:100%;height:240rpx}
.consult-name{font-size:28rpx;font-weight:800;margin-top:12rpx}
.consult-provider,.consult-id{font-size:21rpx;color:#7d858e;margin-top:7rpx}
.consult-video{background:#f5f6f8;padding:28rpx;border-radius:14rpx;text-align:center}
.consult-camera{font-size:29rpx;font-weight:850;margin-bottom:13rpx}
.consult-label{font-size:24rpx;font-weight:800;margin:25rpx 0 13rpx}
.consult-field,.consult-notes{box-sizing:border-box;width:100%;padding:20rpx;border:1rpx solid #dfe1e6;border-radius:12rpx;font-size:25rpx;background:#fff}
.consult-notes{height:165rpx}
.consult-save{background:#191e26;color:#fff;margin-top:28rpx;border-radius:30rpx;font-size:27rpx;font-weight:800}
.consult-alert{padding:30rpx;color:#c55560}

.consult-status{border:1rpx solid #dde2e8;border-radius:14rpx;padding:18rpx;margin-top:22rpx}
.consult-refresh{background:#fff;color:#191e26;border:1rpx solid #9ca4af;margin-top:20rpx;border-radius:30rpx}
