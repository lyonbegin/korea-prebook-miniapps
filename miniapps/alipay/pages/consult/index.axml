<view class="consult-page">
 <view class="consult-logo">KOREA PREBOOK</view>
 <view class="consult-title">商品咨询</view>
 <view class="consult-sub">咨询申请与您选择的商品绑定，而非任意公共聊天室。</view>
 <view a:if="{{loading}}" class="consult-alert">正在加载商品信息…</view>
 <view a:if="{{error}}" class="consult-alert">{{error}}</view>
 <view a:if="{{product}}" class="consult-product">
  <image a:if="{{product.image}}" src="{{product.image}}" mode="aspectFit" class="consult-image"/>
  <view class="consult-name">{{product.name}}</view>
  <view class="consult-provider">{{product.brand}}</view>
  <view class="consult-id">商品编号 {{product.id}}</view>
 </view>
 <view class="consult-video">
  <view class="consult-camera">HITEL · 私密视频咨询</view>
  <view class="consult-info">申请登记与视频接通是不同步骤。仅在管理员分配专属会话后才显示进入按钮；进入仍需 HITEL 身份验证。</view>
 </view>
 <view a:if="{{!request}}">
  <view class="consult-label">期望咨询日期（可选）</view>
  <picker mode="date" value="{{day}}" onChange="onDateChange"><view class="consult-field">{{day||'选择日期'}} ›</view></picker>
  <view class="consult-label">期望时间（可选）</view>
  <picker mode="time" value="{{time}}" onChange="onTimeChange"><view class="consult-field">{{time||'选择时间'}} ›</view></picker>
  <view class="consult-info">请勿在此提交姓名、电话、病历等个人或健康信息。本阶段仅提交商品编号、平台及希望日期和时间。</view>
  <button class="consult-save" onTap="submitRequest" loading="{{submitting}}" disabled="{{submitting||!product}}">提交咨询申请</button>
 </view>
 <view a:if="{{request}}" class="consult-status">
  <view class="consult-label">咨询申请状态</view>
  <view class="consult-id">申请编号 {{request.request_id}}</view>
  <view class="consult-info">{{statusText||'已创建申请，正在等待状态更新'}}</view>
  <button class="consult-refresh" onTap="refreshStatus" loading="{{refreshing}}" disabled="{{refreshing}}">刷新申请状态</button>
  <button a:if="{{canOpenVideo}}" class="consult-save" onTap="openVideo">进入专属视频咨询</button>
  <view class="consult-info">本申请不代表已经预约成功，也不代表视频、音频或咨询员已经接通。</view>
 </view>
</view>