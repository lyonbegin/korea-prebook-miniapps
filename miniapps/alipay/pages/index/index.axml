<view class="catalog-page">
 <view class="catalog-head">
  <view class="catalog-logo">KOREA PREBOOK</view>
  <view class="catalog-title">韩国美丽与旅行服务</view>
  <view class="catalog-sub">选择商品 · 查看详情 · 视频咨询</view>
  <input class="catalog-search" value="{{query}}" placeholder="搜索美容项目、商品或旅游服务" onInput="onSearchInput" onConfirm="onSearchConfirm"/>
 </view>
 <view class="category-title">全部类别</view>
 <view class="category-list">
  <view a:for="{{categories}}" a:key="id" class="category-chip {{activeCategory===item.id?'chosen':''}}" data-id="{{item.id}}" onTap="onCategoryTap">{{item.name_zh}}</view>
 </view>
 <view class="listing-title">相关商品</view>
 <view a:if="{{loading}}" class="info-line">正在加载商品...</view>
 <view a:if="{{!loading&&visibleProducts.length===0}}" class="info-line">
  暂无已发布商品。商品须由运营方登记后展示。
 </view>
 <view class="listing-grid">
  <view a:for="{{visibleProducts}}" a:key="id" class="listing-card" data-id="{{item.id}}" data-source="{{item.source}}" onTap="onProductTap">
   <image a:if="{{item.image}}" class="listing-image" src="{{item.image}}" mode="aspectFit"/>
   <view a:else class="listing-image fallback">KOREA PREBOOK</view>
   <view class="listing-meta">{{item.source==='cosmetics'?'K-BEAUTY':'SERVICE'}}</view>
   <view class="listing-name">{{item.name}}</view>
   <view class="listing-subtitle">{{item.subtitle}}</view>
   <view class="listing-price">{{item.priceText}}</view>
   <view class="listing-link">查看详情与咨询 ›</view>
  </view>
 </view>
 <view a:if="{{networkError}}" class="info-line error">部分目录暂时无法连接；请稍后刷新。</view>
 <view class="refresh" onTap="onRefresh">重新加载</view>
 <view class="info-line">视频咨询尚需正式平台授权和 HITEL 连接验证；页面不代表真实预约已确认。</view>
</view>