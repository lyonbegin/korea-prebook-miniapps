<view class="container">
 <view class="hero">
  <view class="title">{{title_zh}}</view>
  <view class="subtitle">{{subtitle_zh}}</view>
 </view>
 <view class="section">提前安排您的韩国之旅</view>
 <view a:for="{{services}}" a:key="kind" class="card" data-kind="{{item.kind}}" onTap="onServiceTap">
  <view class="name">{{item.name_zh}}</view><view class="desc">预约与购物咨询服务</view>
 </view>
 <view class="note">{{status}}</view>
</view>
