.eyebrow{font-size:19rpx;letter-spacing:2rpx;opacity:.8;margin-bottom:14rpx}
.intro{font-size:24rpx;line-height:1.6;color:#69808c;margin-bottom:20rpx}
.row{display:flex;align-items:center;justify-content:space-between}
.tag{font-size:19rpx;color:#567782;padding:6rpx 14rpx;background:#edf3f4;border-radius:40rpx}
.consult-card{background:#fff;padding:30rpx;margin:22rpx 0;border:1rpx solid #dce6e9;border-radius:18rpx}
.form-title{font-size:31rpx;font-weight:700}
.form-lead{font-size:22rpx;color:#6a7f8c;margin:13rpx 0 22rpx;line-height:1.5}
.field-label{font-size:22rpx;margin:20rpx 0 9rpx;font-weight:600}
.picker-field,.input,.textarea{box-sizing:border-box;background:#f6f8f9;padding:19rpx 18rpx;border:1rpx solid #e0e6e9;border-radius:10rpx;font-size:26rpx;width:100%}
.textarea{height:150rpx}
.save-button,.shop-button{background:#163949!important;color:#fff!important;font-size:25rpx;margin-top:24rpx}
.close-text{text-align:center;color:#58727e;padding:16rpx;font-size:23rpx}
.shop-box{background:#fff;padding:29rpx;border-radius:18rpx;border:1rpx solid #e0e6e9;margin-top:25rpx}
