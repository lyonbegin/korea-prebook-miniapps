.kt-app{min-height:100vh;background:#fff;color:#151515;padding-bottom:125rpx;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;}
.shop-top{padding:32rpx 30rpx 20rpx;background:#fff;border-bottom:1rpx solid #eceef3;}
.shop-brand-row{display:flex;justify-content:space-between;align-items:center;}
.shop-brand{font-size:43rpx;font-weight:900;letter-spacing:-1.4rpx;color:#151515;}
.shop-top-right{font-size:19rpx;letter-spacing:2rpx;color:#737887;font-weight:700;}
.shop-title{font-size:27rpx;font-weight:800;margin:9rpx 0 17rpx;}
.lang-scroll,.sort-scroller,.category-scroller{width:100%;white-space:nowrap;}
.lang-list,.sort-line,.category-line{display:flex;align-items:center;gap:13rpx;width:max-content;padding-bottom:4rpx;}
.lang-pill{border:1rpx solid #eceef3;border-radius:32rpx;font-size:23rpx;font-weight:600;padding:10rpx 21rpx;color:#555a69;background:#fff;}
.lang-selected{border-color:#ff3152;color:#ff3152;background:#fff0f3;font-weight:800;}
.shop-content{padding:0 26rpx 40rpx;}
.search-row{height:82rpx;border:2rpx solid #d0d3dc;border-radius:45rpx;display:flex;align-items:center;margin:26rpx 0 24rpx;padding:0 16rpx 0 23rpx;}
.search-icon{font-size:50rpx;line-height:1;color:#717783;margin-right:12rpx;}
.search-input{font-size:25rpx;flex:1;min-width:0;}
.placeholder{color:#a0a6b1;}
.search-action{border-radius:33rpx;padding:15rpx 19rpx;background:#ff3152;color:#fff;font-size:22rpx;font-weight:800;}
.promo-strip{background:linear-gradient(125deg,#ffe9ee,#fff3f5 58%,#f7f5ff);border-radius:24rpx;padding:36rpx 35rpx;margin-bottom:25rpx;min-height:175rpx;}
.promo-overline{font-size:19rpx;color:#a54862;font-weight:900;letter-spacing:2rpx;}
.promo-heading{font-size:54rpx;font-weight:900;letter-spacing:-2rpx;margin:7rpx 0;}
.promo-heading text{color:#ff3152;}
.promo-sub{color:#814a5b;font-size:21rpx;letter-spacing:.5rpx;}
.promo-tag{display:inline-block;margin-top:18rpx;padding:10rpx 17rpx;border-radius:26rpx;background:#ff3152;color:#fff;font-size:17rpx;font-weight:800;}
.sort-line{padding:0 0 22rpx;}
.sort-chip{padding:18rpx 27rpx;background:#fff;border:1.5rpx solid #eceef3;border-radius:45rpx;color:#616571;font-size:25rpx;font-weight:800;}
.sort-chip.selected{background:#ff3152;border-color:#ff3152;color:#fff;}
.section-heading{display:flex;align-items:center;gap:16rpx;margin:11rpx 0 17rpx;font-size:32rpx;font-weight:900;}
.section-heading-line{height:2rpx;flex:1;background:#eceef3;}
.category-line{padding-bottom:20rpx;}
.category-pill{padding:18rpx 25rpx;border-radius:30rpx;border:1rpx solid #edeef3;font-size:23rpx;color:#636978;font-weight:700;}
.category-pill.category-active{background:#fff0f3;border-color:#ff3152;color:#ff3152;font-weight:900;}
.results-heading{display:flex;justify-content:space-between;align-items:center;margin:14rpx 0 19rpx;}
.results-heading-title{font-size:31rpx;font-weight:900;}
.results-count{font-size:21rpx;color:#9497a2;font-weight:700;}
.product-grid{display:flex;flex-wrap:wrap;justify-content:space-between;}
.product-item{border:1rpx solid #eceef3;width:48.1%;margin-bottom:22rpx;border-radius:20rpx;overflow:hidden;background:#fff;box-sizing:border-box;}
.product-picture{height:316rpx;margin:10rpx;border-radius:16rpx;background:linear-gradient(135deg,#fff7f8,#f5f7fb);position:relative;display:flex;align-items:center;justify-content:center;}
.product-photo{width:100%;height:100%;}
.picture-placeholder{font-size:23rpx;color:#c3aab0;font-weight:900;}
.sale-label,.new-label{position:absolute;top:8rpx;left:8rpx;border-radius:9rpx;background:#ff3152;color:#fff;font-size:19rpx;font-weight:900;padding:7rpx 12rpx;}
.new-label{background:#7546ff;}
.product-meta{padding:5rpx 15rpx 21rpx;}
.product-brand{font-size:21rpx;font-weight:900;color:#343640;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.product-name{font-size:24rpx;font-weight:650;line-height:1.45;height:70rpx;overflow:hidden;margin-top:7rpx;}
.product-price-row{margin-top:11rpx;display:flex;align-items:baseline;gap:9rpx;flex-wrap:wrap;}
.product-price{font-size:28rpx;font-weight:900;color:#ff3152;}
.product-old{text-decoration:line-through;color:#969aa5;font-size:19rpx;}
.review-count{color:#777e8c;font-size:19rpx;margin-top:8rpx;}
.shop-message{text-align:center;color:#9096a2;padding:62rpx 20rpx;font-size:24rpx;}
.shop-warning{font-size:22rpx;color:#c25c65;padding:22rpx;}
.load-more{text-align:center;border:1rpx solid #f2c5d0;color:#ff3152;padding:23rpx;border-radius:30rpx;font-size:24rpx;font-weight:800;margin:18rpx 0 28rpx;}
.bag-disclaimer{text-align:center;color:#888d98;font-size:21rpx;padding:22rpx;}
.native-tabs{position:fixed;bottom:0;left:0;right:0;display:flex;justify-content:space-around;background:#fff;border-top:1rpx solid #e8eaf0;z-index:20;padding:14rpx 6rpx 32rpx;}
.tab-cell{flex:1;text-align:center;font-size:18rpx;color:#838796;font-weight:700;}
.tab-icon{font-size:39rpx;line-height:47rpx;margin-bottom:6rpx;}
.tab-active{color:#ff3152;}
