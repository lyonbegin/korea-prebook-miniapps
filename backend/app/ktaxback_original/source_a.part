// K-TaxBack — 실제 프로덕션 JSON(main-vue-data.json 등)을 같은 폴더에서
// fetch 로 동적 로딩해서 그린다. 하드코딩된 상품/배너 배열은 없다.
//
// 홈 화면은 main-vue-data.json 의 cornerList 를 그대로 순회하며 렌더링한다.
// 각 corner 의 setContsMap 안에 set_1, set_2… 가 있고, 그 안에 IMAGE/TEXT/PRODUCT/
// SET_NAME 중 하나(또는 IMAGE+TEXT 조합)가 들어있다. 이 파일이 하드코딩을 안 하는
// 대신, 실제 화면 레이아웃(히어로냐 브랜드그리드냐)을 데이터만으로 100% 구분할 수는
// 없어서(둘 다 IMAGE+TEXT 구조가 같음) — C100022 코너는 전부 한 캐러셀로 그린다.
// 정확한 시각 분리가 필요하면 백엔드 쪽에 corner 를 나누는 필드가 있는지 확인 필요.
import React, { useState, useRef, useEffect } from "https://esm.sh/react@18.2.0";
import ReactDOM from "https://esm.sh/react-dom@18.2.0/client";
import { motion, AnimatePresence } from "https://esm.sh/framer-motion@11.3.24?deps=react@18.2.0,react-dom@18.2.0";
import {
  Menu, Search, ShoppingBag, X, ChevronRight, ChevronLeft, ChevronDown, ChevronUp,
  Heart, Star, Pause, Play, Home, Grid3x3, Tag, User, Download, Loader2,
  Droplet, Palette, Waves, Scissors, SmilePlus, Sun, Music2, Paintbrush,
  Gem, HeartPulse, Pill, Coffee, Gift, Globe, Headset, Truck, SlidersHorizontal, Share2, Check,
} from "https://esm.sh/lucide-react@0.383.0?deps=react@18.2.0";

// 지원 언어. code 는 DB(product_translations/lang_code, 완전스냅샷 폴더)와 그대로 맞춘다.
// 'en' 은 오버레이/스냅샷 자체가 없는 정본이라 항상 표시 가능.
const LANGUAGES = [
  { code: "en", label: "English", short: "Eng (US$)" },
  { code: "jp", label: "日本語", short: "JP (¥)" },
  { code: "vi_vn", label: "Tiếng Việt", short: "VI (₫)" },
  { code: "zh_cn", label: "中文（简体）", short: "简体中文" },
  { code: "zh_tw", label: "中文（繁體）", short: "繁體中文" },
];
function langShortLabel(code) {
  return (LANGUAGES.find((l) => l.code === code) || LANGUAGES[0]).short;
}
// 헤더에 표시할 "현재 언어" — 영어로 된 라벨이 아니라 그 나라 글씨 그대로
// (English/日本語/Tiếng Việt/中文（简体）/中文（繁體）).
function langNativeLabel(code) {
  return (LANGUAGES.find((l) => l.code === code) || LANGUAGES[0]).label;
}

