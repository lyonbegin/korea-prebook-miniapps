FROM mcr.microsoft.com/playwright/python:v1.64.0-noble
WORKDIR /app
RUN pip install --no-cache-dir playwright==1.64.0
COPY workers/oliveyoung/worker.py /app/worker.py
COPY workers/oliveyoung/pilot.py /app/pilot.py
COPY workers/oliveyoung/source_translations.py /app/source_translations.py
ENV PYTHONUNBUFFERED=1
CMD ["python", "-u", "/app/pilot.py"]
